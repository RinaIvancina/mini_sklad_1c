
Процедура ОбработкаПроведения(Отказ, Режим)
	// регистр ТоварыНаСкладах Приход
	Движения.ТоварыНаСкладах.Записывать = Истина;
	Для Каждого СтрокаПереченьТоваров Из ПереченьТоваров Цикл 
		Если СтрокаПереченьТоваров.Товар.ВидНоменклатуры =             Перечисления.ВидыНоменклатуры.Услуга Тогда
		ДвижениеТоварыНаСкладах = Движения.ТоварыНаСкладах.Добавить();
		ДвижениеТоварыНаСкладах.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеТоварыНаСкладах.Период = Дата;
		ДвижениеТоварыНаСкладах.Товар = СтрокаПереченьТоваров.Товар;
		ДвижениеТоварыНаСкладах.Количество = СтрокаПереченьТоваров.Количество; 
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
