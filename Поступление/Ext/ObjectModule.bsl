
Процедура ОбработкаПроведения(Отказ, Режим)
	
		
	// регистр ТоварыНаСкладах Приход
	Движения.ТоварыНаСкладах.Записывать = Истина;
	Для Каждого СтрокаСпискаТоваров Из СписокТоваров Цикл
		ДвижениеТоварыНаСкладах = Движения.ТоварыНаСкладах.Добавить();
		ДвижениеТоварыНаСкладах.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеТоварыНаСкладах.Период = Дата;
		ДвижениеТоварыНаСкладах.Товар = СтрокаСпискаТоваров.Товар;
		ДвижениеТоварыНаСкладах.Склад = Склад;
		ДвижениеТоварыНаСкладах.Количество = СтрокаСпискаТоваров.Количество;
	КонецЦикла;
	// регистр ОборотыПоТоварам 
	Движения.ОборотыПоТоварам.Записывать = Истина;
	Для Каждого СтрокаСписокТоваров Из СписокТоваров Цикл
		ДвижениеОборотыПоТоварам = Движения.ОборотыПоТоварам.Добавить();
		ДвижениеОборотыПоТоварам.Период = Дата;
		ДвижениеОборотыПоТоварам.Товар
		= СтрокаСписокТоваров.Товар;
		ДвижениеОборотыПоТоварам.Склад = Склад;
		ДвижениеОборотыПоТоварам.Количество = СтрокаСписокТоваров.Количество;
	КонецЦикла;


КонецПроцедуры
